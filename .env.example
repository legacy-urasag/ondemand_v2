# Application Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# CORS Configuration (Comma-separated allowed origins, no wildcard '*' for private/credential routes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & JWT
JWT_SECRET=ondemand_secure_jwt_key_at_least_32_chars_long_2026_dev
JWT_EXPIRES_IN=3600

# Rate Limiting Configuration
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_FORMS=15
RATE_LIMIT_MAX_AUTH=5

# Bootstrap Accounts for Admin / Operator Access
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=AdminSecure2026!
OPERATOR_BOOTSTRAP_USER=operator
OPERATOR_BOOTSTRAP_PASS=OperatorSecure2026!

