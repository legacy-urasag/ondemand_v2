{
  "name": "ondemand-platform",
  "version": "1.0.0",
  "description": "OnDemand - Verified handymen & home service platform in Budapest",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node --import tsx/esm src/index.ts",
    "dev": "node --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test tests/backend/*.test.ts",
    "test:e2e": "node --import tsx/esm --test tests/e2e/*.test.ts",
    "test:all": "node --import tsx/esm --test tests/backend/*.test.ts tests/e2e/*.test.ts"
  },
  "keywords": [
    "ondemand",
    "budapest",
    "home-services",
    "zod",
    "security",
    "seo"
  ],
  "author": "OnDemand Kft.",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

